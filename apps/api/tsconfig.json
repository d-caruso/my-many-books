{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "types": ["node", "jest"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@/types/*": ["src/types/*"],
      "@/utils/*": ["src/utils/*"],
      "@/models/*": ["src/models/*"],
      "@/services/*": ["src/services/*"],
      "@/controllers/*": ["src/controllers/*"],
      "@/handlers/*": ["src/handlers/*"],
      "@my-many-books/shared-auth": ["../../libs/shared-auth/src/authorization/index.ts"],
      "@my-many-books/shared-i18n": ["../../libs/shared-i18n/src/index.ts"],
      "@my-many-books/shared-i18n/*": ["../../libs/shared-i18n/src/*"],
      "@my-many-books/shared-logging": ["../../libs/shared-logging/src/index.ts"],
      "@my-many-books/shared-logging/*": ["../../libs/shared-logging/src/*"],
      "@my-many-books/shared-types": ["../../libs/shared-types/src/index.ts"],
      "@my-many-books/shared-types/*": ["../../libs/shared-types/src/*"],
      "@my-many-books/shared-utils": ["../../libs/shared-utils/src/index.ts"],
      "@my-many-books/shared-utils/*": ["../../libs/shared-utils/src/*"],
      "@my-many-books/shared-validation": ["../../libs/shared-validation/src/index.ts"],
      "@my-many-books/shared-validation/*": ["../../libs/shared-validation/src/*"],
      "@my-many-books/hookey": ["../../libs/hookey/src/index.ts"],
      "@my-many-books/hookey/*": ["../../libs/hookey/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*.ts",
    "../../libs/**/*.tsx",
    "../../libs/**/react/**/*"
  ]
}
