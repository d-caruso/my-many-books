{
 "info": {
  "_postman_id": "a1b2c3d4-e5f6-4789-a0b1-c2d3e4f5g6h7",
  "name": "My Many Books API",
  "description": "Comprehensive API testing collection for My Many Books. Includes authentication (AWS Cognito), authorization (CASL), hooks system, and all CRUD operations.\n\n**Latest Update:** February 2026 - Complete endpoint sync with API routes. Added Users, Settings, Config, Mobile Analytics, Admin Mobile sections.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "_exporter_id": "12345678"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{idToken}}",
    "type": "string"
   }
  ]
 },
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "if (!pm.environment.get('traceId')) {",
     "    pm.environment.set('traceId', pm.variables.replaceIn('{{$guid}}'));",
     "}",
     "",
     "const tokenExpiry = pm.environment.get('tokenExpiry');",
     "if (tokenExpiry && Date.now() > tokenExpiry) {",
     "    console.log('Token expired, please refresh');",
     "}"
    ]
   }
  },
  {
   "listen": "test",
   "script": {
    "type": "text/javascript",
    "exec": [
     "pm.test('Response time is acceptable', function() {",
     "    pm.expect(pm.response.responseTime).to.be.below(5000);",
     "});",
     "",
     "pm.test('Status code is valid', function() {",
     "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 400, 401, 403, 404, 422, 500]);",
     "});"
    ]
   }
  }
 ],
 "item": [
  {
   "name": "Authentication",
   "description": "AWS Cognito authentication endpoints",
   "item": [
    {
     "name": "Register",
     "request": {
      "auth": {"type": "noauth"},
      "method": "POST",
      "header": [
       {"key": "Content-Type", "value": "application/json"},
       {"key": "x-trace-id", "value": "{{traceId}}"}
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Test\",\n  \"surname\": \"User\"\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/auth/register",
       "host": ["{{baseUrl}}"],
       "path": ["auth", "register"]
      }
     }
    },
    {
     "name": "Login",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "if (pm.response.code === 200) {",
         "    const jsonData = pm.response.json();",
         "    pm.environment.set('idToken', jsonData.idToken);",
         "    pm.environment.set('accessToken', jsonData.accessToken);",
         "    pm.environment.set('tokenExpiry', Date.now() + 3600000);",
         "    pm.environment.set('userId', jsonData.user.id);",
         "    pm.environment.set('userRole', jsonData.user.role);",
         "}"
        ],
        "type": "text/javascript"
       }
      }
     ],
     "request": {
      "auth": {"type": "noauth"},
      "method": "POST",
      "header": [
       {"key": "Content-Type", "value": "application/json"},
       {"key": "x-trace-id", "value": "{{traceId}}"}
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
      },
      "url": {
       "raw": "{{baseUrl}}/auth/login",
       "host": ["{{baseUrl}}"],
       "path": ["auth", "login"]
      }
     }
    },
    {
     "name": "Refresh Token",
     "request": {
      "auth": {"type": "noauth"},
      "method": "POST",
      "header": [{"key": "x-trace-id", "value": "{{traceId}}"}],
      "url": {
       "raw": "{{baseUrl}}/auth/refresh",
       "host": ["{{baseUrl}}"],
       "path": ["auth", "refresh"]
      }
     }
    },
    {
     "name": "Logout",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "pm.environment.unset('idToken');",
         "pm.environment.unset('accessToken');",
         "pm.environment.unset('tokenExpiry');"
        ],
        "type": "text/javascript"
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [{"key": "x-trace-id", "value": "{{traceId}}"}],
      "url": {
       "raw": "{{baseUrl}}/auth/logout",
       "host": ["{{baseUrl}}"],
       "path": ["auth", "logout"]
      }
     }
    }
   ]
  },
