	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{idToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Generate trace ID for request correlation",
					"if (!pm.environment.get('traceId')) {",
					"    pm.environment.set('traceId', pm.variables.replaceIn('{{$guid}}'));",
					"}",
					"",
					"// Check if token is expired (simple check)",
					"const tokenExpiry = pm.environment.get('tokenExpiry');",
					"if (tokenExpiry && Date.now() > tokenExpiry) {",
					"    console.log('Token expired, please refresh');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test validations",
					"pm.test('Response time is acceptable', function() {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"// Check for traceId in response logs (if available)",
					"pm.test('Status code is valid', function() {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 400, 401, 403, 404, 422, 500]);",
					"});"
				]
			}
		}
	],
	"item": [
		{
			"name": "Authentication",
			"description": "AWS Cognito authentication endpoints with automatic token management",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Registration successful', function() {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has user data', function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('user');",
									"    pm.expect(jsonData.user).to.have.property('email');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-trace-id",
								"value": "{{traceId}}",
								"description": "Request correlation ID"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Test\",\n  \"surname\": \"User\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"description": "Register a new user with email and password"
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login successful', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response contains tokens', function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('idToken');",
									"    pm.expect(jsonData).to.have.property('accessToken');",
									"    pm.expect(jsonData).to.have.property('user');",
									"",
									"    // Store tokens for subsequent requests",
									"    pm.environment.set('idToken', jsonData.idToken);",
									"    pm.environment.set('accessToken', jsonData.accessToken);",
									"    ",
									"    // Store token expiry (1 hour from now)",
									"    pm.environment.set('tokenExpiry', Date.now() + 3600000);",
									"    ",
									"    // Store user info",
									"    pm.environment.set('userId', jsonData.user.id);",
									"    pm.environment.set('userRole', jsonData.user.role);",
									"});",
									"",
									"pm.test('User has valid role', function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.user.role).to.be.oneOf(['user', 'admin']);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-trace-id",
								"value": "{{traceId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Login with email and password. Returns ID token, access token, and refresh token (HttpOnly cookie)."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Token refresh successful', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('New tokens received', function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('idToken');",
									"    pm.expect(jsonData).to.have.property('accessToken');",
									"",
									"    // Update stored tokens",
									"    pm.environment.set('idToken', jsonData.idToken);",
									"    pm.environment.set('accessToken', jsonData.accessToken);",
									"    pm.environment.set('tokenExpiry', Date.now() + 3600000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
