							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "refresh"]
						},
						"description": "Refresh expired tokens using refresh token from HttpOnly cookie. Returns new ID and access tokens."
