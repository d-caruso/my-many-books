{
  "name": "my-many-books-web",
  "version": "0.1.0",
  "type": "module",
  "homepage": ".",
  "private": true,
  "dependencies": {
    "@aws-amplify/ui-react": "^6.13.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/system": "^7.3.3",
    "@mui/x-data-grid": "^8.16.0",
    "@mui/x-date-pickers": "^8.16.0",
    "@my-many-books/shared-api": "file:../../libs/shared-api",
    "@my-many-books/shared-auth": "file:../../libs/shared-auth",
    "@my-many-books/shared-design": "file:../../libs/shared-design",
    "@my-many-books/shared-forms": "file:../../libs/shared-forms",
    "@my-many-books/shared-i18n": "file:../../libs/shared-i18n",
    "@my-many-books/shared-navigation": "file:../../libs/shared-navigation",
    "@my-many-books/shared-types": "file:../../libs/shared-types",
    "@my-many-books/shared-ui-hooks": "file:../../libs/shared-ui-hooks",
    "@my-many-books/shared-utils": "file:../../libs/shared-utils",
    "@my-many-books/shared-validation": "file:../../libs/shared-validation",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^19.1.13",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "aws-amplify": "^6.15.8",
    "axios": "^1.11.0",
    "dayjs": "^1.11.18",
    "i18next": "^23.8.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^3.0.2",
    "react": "19.1.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "19.1.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^7.8.0",
    "typescript": "^5.4.0",
    "web-vitals": "^2.1.4",
    "zod": "^4.1.13"
  },
  "scripts": {
    "sync-translations": "bash ../../scripts/sync-translations.sh",
    "prestart": "npm run sync-translations",
    "start": "vite",
    "prebuild": "npm run sync-translations",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest",
    "test:web-app:components": "vitest run --config vitest.config.components.ts",
    "test:web-app:components:auth": "vitest run --config vitest.config.components.ts src/__tests__/components/Auth",
    "test:web-app:components:book": "vitest run --config vitest.config.components.ts src/__tests__/components/Book",
    "test:web-app:components:error-boundary": "vitest run --config vitest.config.components.ts src/__tests__/components/ErrorBoundary",
    "test:web-app:components:layout": "vitest run --config vitest.config.components.ts src/__tests__/components/Layout",
    "test:web-app:components:navigation": "vitest run --config vitest.config.components.ts src/__tests__/components/Navigation",
    "test:web-app:components:pwa": "vitest run --config vitest.config.components.ts src/__tests__/components/PWA",
    "test:web-app:components:scanner": "vitest run --config vitest.config.components.ts src/__tests__/components/Scanner",
    "test:web-app:components:search:form": "vitest run --config vitest.config.components.ts src/__tests__/components/Search/BookSearchForm.test.tsx",
    "test:web-app:components:search:page": "vitest run --config vitest.config.components.ts src/__tests__/components/Search/BookSearchPage.test.tsx",
    "test:web-app:components:search:results": "vitest run --config vitest.config.components.ts src/__tests__/components/Search/BookSearchResults.test.tsx",
    "test:web-app:components:theme": "vitest run --config vitest.config.components.ts src/__tests__/components/Theme",
    "test:web-app:components:ui": "vitest run --config vitest.config.components.ts src/__tests__/components/UI",
    "test:web-app:components:hook-executions": "vitest run --config vitest.config.components.ts src/__tests__/components/HookExecutions.test.tsx",
    "test:web-app:components:hook-form": "vitest run --config vitest.config.components.ts src/__tests__/components/HookForm.test.tsx",
    "test:web-app:components:hooks-list": "vitest run --config vitest.config.components.ts src/__tests__/components/HooksList.test.tsx",
    "test:web-app:components:protected-route": "vitest run --config vitest.config.components.ts src/__tests__/components/ProtectedRoute.test.tsx",
    "test:web-app:pages:admin-dashboard": "vitest run --config vitest.config.pages.ts src/__tests__/pages/Admin/AdminDashboardPage.test.tsx",
    "test:web-app:pages:admin-layout": "vitest run --config vitest.config.pages.ts src/__tests__/pages/Admin/AdminLayout.test.tsx",
    "test:web-app:pages:admin-settings": "vitest run --config vitest.config.pages.ts src/__tests__/pages/Admin/AdminSettingsPage.test.tsx",
    "test:web-app:pages:admin-book-management": "vitest run --config vitest.config.pages.ts src/__tests__/pages/Admin/BookManagementPage.test.tsx",
    "test:web-app:pages:admin-hooks": "vitest run --config vitest.config.pages.ts src/__tests__/pages/Admin/HooksPage.test.tsx",
    "test:web-app:pages:admin-user-management": "vitest run --config vitest.config.pages.ts src/__tests__/pages/Admin/UserManagementPage.test.tsx",
    "test:web-app:pages:auth": "vitest run --config vitest.config.pages.ts src/__tests__/pages/AuthPage.test.tsx",
    "test:web-app:pages:books": "vitest run --config vitest.config.pages.ts src/__tests__/pages/BooksPage.test.tsx",
    "test:web-app:accessibility": "vitest run --config vitest.config.ts src/__tests__/accessibility",
    "test:web-app:types": "vitest run --config vitest.config.ts src/__tests__/types --passWithNoTests",
    "test:web-app:utils": "vitest run --config vitest.config.ts src/__tests__/utils",
    "test:web-app:pages": "vitest run --config vitest.config.pages.ts",
    "test:web-app:services": "vitest run --config vitest.config.services.ts",
    "test:web-app:integration": "vitest run --config vitest.config.integration.ts",
    "test:web-app:hooks": "vitest run --config vitest.config.hooks.ts",
    "test:min": "VITEST_USE_MINIMAL=1 vitest run",
    "test:coverage": "craco test --coverage --watchAll=false",
    "test:unit": "craco test --testPathPattern=src/ --watchAll=false",
    "test:unit:watch": "craco test --testPathPattern=src/",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:component": "cypress run --component",
    "cypress:component:open": "cypress open --component",
    "e2e": "start-server-and-test start http://localhost:3000 cypress:run",
    "e2e:open": "start-server-and-test start http://localhost:3000 cypress:open",
    "test:ci": "craco test --coverage --ci --watchAll=false --testResultsProcessor=jest-sonar-reporter",
    "test:all": "npm run test:unit && npm run cypress:component && npm run e2e",
    "test:coverage:full": "npm run test:coverage && npm run cypress:run --coverage",
    "eject": "react-scripts eject",
    "typecheck": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nx/eslint": "^21.3.11",
    "@nx/webpack": "^21.3.11",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/ui": "^3.2.4",
    "axe-core": "^4.11.0",
    "buffer": "^4.9.2",
    "crypto-browserify": "^3.12.1",
    "cypress": "^14.5.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.0",
    "leven": "^4.1.0",
    "msw": "^2.10.5",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "rollup-plugin-visualizer": "^6.0.5",
    "start-server-and-test": "^2.0.13",
    "stream-browserify": "^3.0.0",
    "typescript-eslint": "^8.49.0",
    "util": "^0.12.5",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "whatwg-fetch": "^3.6.20",
    "workbox-window": "^7.3.0"
  }
}
