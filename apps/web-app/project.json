{
  "name": "web-app",
  "version": "0.1.0",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-app/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/web-app/build"],
      "options": {
        "command": "npm run build",
        "cwd": "apps/web-app"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "web-app:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "web-app:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "web-app:build:production",
          "hmr": false
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "apps/web-app/vitest.config.ts"
      }
    },
    "test:components": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "apps/web-app/vitest.config.components.ts"
      }
    },
    "test:pages": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "apps/web-app/vitest.config.pages.ts"
      }
    },
    "test:services": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "apps/web-app/vitest.config.services.ts"
      }
    },
    "test:integration": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "apps/web-app/vitest.config.integration.ts"
      }
    },
    "test:hooks": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "configFile": "apps/web-app/vitest.config.hooks.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/web-app/**/*.{ts,tsx,js,jsx}",
          "!apps/web-app/build/**",
          "!apps/web-app/dist/**"
        ]
      }
    }
  },
  "tags": ["scope:web-app", "type:app"]
}
