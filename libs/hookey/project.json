{
  "name": "hookey",
  "root": "libs/hookey",
  "sourceRoot": "libs/hookey/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/hookey",
        "main": "libs/hookey/src/index.ts",
        "tsConfig": "libs/hookey/tsconfig.lib.json",
        "assets": []
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/hookey/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [],
      "options": {
        "lintFilePatterns": [
          "libs/hookey/**/*.ts",
          "!libs/hookey/examples/**"
        ]
      }
    }
  },
  "tags": ["scope:shared", "type:lib"]
}
