{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "shared-validation",
  "sourceRoot": "libs/shared-validation/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/libs/shared-validation"
      ],
      "options": {
        "command": "tsc",
        "cwd": "libs/shared-validation"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/shared-validation/src/**/*.ts"
        ],
        "eslintConfig": "libs/shared-validation/eslint.config.mjs"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/shared-validation/jest.config.js",
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "libs/shared-validation"
      }
    }
  },
  "tags": [
    "type:shared",
    "scope:validation"
  ]
}
