{
  "name": "shared-i18n",
  "version": "0.1.0",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared-i18n/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "libs/shared-i18n/dist",
        "main": "libs/shared-i18n/src/index.ts",
        "tsConfig": "libs/shared-i18n/tsconfig.lib.json",
        "assets": [
          "libs/shared-i18n/*.md",
          {
            "glob": "**/*",
            "input": "libs/shared-i18n/src/locales",
            "output": "locales"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/shared-i18n/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared-i18n/jest.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "libs/shared-i18n"
      }
    }
  },
  "tags": ["scope:shared", "type:lib"]
}
