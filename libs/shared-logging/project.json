{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "shared-logging",
  "sourceRoot": "libs/shared-logging/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsc",
        "cwd": "libs/shared-logging"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/shared-logging/src/**/*.ts"
        ],
        "eslintConfig": "libs/shared-logging/eslint.config.mjs"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/shared-logging/jest.config.ts",
        "passWithNoTests": true,
        "runInBand": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "libs/shared-logging"
      }
    }
  },
  "tags": [
    "type:shared",
    "scope:logging"
  ]
}
