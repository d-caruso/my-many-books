{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
        "request": "launch",
        "name": "Debug API (ts-node)",
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/ts-node",
        "runtimeArgs": ["-r", "tsconfig-paths/register"],
        "args": ["src/app.ts"],
        "cwd": "${workspaceFolder}/apps/api",
        "sourceMaps": true,
        "skipFiles": ["<node_internals>/**"]
    }
  ]
}