{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom", "dom.iterable"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@my-many-books/shared-types": ["libs/shared-types/src/index.ts"],
      "@my-many-books/shared-api": ["libs/shared-api/src/index.ts"],
      "@my-many-books/ui-components": ["libs/ui-components/src/index.ts"],
      "@my-many-books/shared-utils": ["libs/shared-utils/src/index.ts"],
      "@my-many-books/shared-ui-hooks": ["libs/shared-ui-hooks/src/index.ts"],
      "@my-many-books/shared-design": ["libs/shared-design/src/index.ts"],
      "@my-many-books/shared-navigation": ["libs/shared-navigation/src/index.ts"],
      "@my-many-books/shared-forms": ["libs/shared-forms/src/index.ts"],
      "@my-many-books/shared-auth": ["libs/shared-auth/src/index.ts"],
      "@my-many-books/shared-i18n": ["libs/shared-i18n/src/index.ts"],
      "@my-many-books/shared-logging": ["libs/shared-logging/src/index.ts"],
      "@my-many-books/shared-validation": ["libs/shared-validation/src/index.ts"],
      "@my-many-books/hookey": ["libs/hookey/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
